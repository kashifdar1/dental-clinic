{
  "name": "@clinic-hub/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import=tsx --watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "bootstrap:db": "node --env-file-if-exists=.env --import=tsx src/bootstrap-test-db.ts",
    "migrate:db": "node --env-file-if-exists=.env --import=tsx src/migrate.ts",
    "test:db": "vitest run --config vitest.db.config.ts"
  },
  "dependencies": {
    "@clinic-hub/shared": "*",
    "@fastify/cookie": "^11.0.0",
    "@fastify/swagger": "^9.5.0",
    "fastify": "^5.0.0",
    "jose": "^6.0.0",
    "kysely": "^0.29.6",
    "pg": "^8.16.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.5",
    "typescript": "~6.0.2",
    "vitest": "^4.0.18"
  }
}
