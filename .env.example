# Public app name shown in the shell
VITE_APP_NAME=Clinic Hub

# Demo storage key namespace (change per environment)
VITE_STORAGE_KEY=clinic-hub-demo-v7

# Allow ?host= overrides outside localhost for controlled demo environments.
VITE_ALLOW_HOST_OVERRIDE=false

# Origin used by the build-time sitemap and canonical SEO URLs.
VITE_PUBLIC_SITE_ORIGIN=https://clinic-hub.example
